ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatoriq

# Generate a real one for actual use, e.g.: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required for Sprint 5 (YouTube sync). Get a free key at
# https://console.cloud.google.com/ -> enable "YouTube Data API v3" -> Credentials -> API Key
YOUTUBE_API_KEY=
