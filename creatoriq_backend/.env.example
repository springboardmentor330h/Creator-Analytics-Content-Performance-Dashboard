# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatoriq

# JWT Security
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# YouTube Integration
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/social/youtube/callback

# Instagram Integration
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
META_CLIENT_ID=your_meta_client_id
META_CLIENT_SECRET=your_meta_client_secret
META_REDIRECT_URI=http://localhost:5173/api/social/instagram/callback
